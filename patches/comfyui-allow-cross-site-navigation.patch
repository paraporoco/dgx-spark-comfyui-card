--- server.py.orig-0.39.0	2026-10-06 21:44:10.524631890 +0200
+++ server.py	2026-10-07 07:59:51.566072685 +0200
@@ -202,7 +202,15 @@
         if 'Sec-Fetch-Site' in request.headers:
             sec_fetch_site = request.headers['Sec-Fetch-Site']
             if sec_fetch_site == 'cross-site':
-                return web.Response(status=403)
+                # Local patch (dgx-spark-comfyui-card): a cross-site TOP-LEVEL
+                # GET navigation -- a link clicked on the DGX Dashboard card --
+                # cannot queue work, so let it through. Cross-site fetches,
+                # subresources and every non-GET method are still refused.
+                navigation = (request.method == "GET"
+                              and request.headers.get('Sec-Fetch-Mode') == 'navigate'
+                              and request.headers.get('Sec-Fetch-Dest') == 'document')
+                if not navigation:
+                    return web.Response(status=403)
         #this code is used to prevent the case where a random website can queue comfy workflows by making a POST to 127.0.0.1 which browsers don't prevent for some dumb reason.
         #in that case the Host and Origin hostnames won't match
         #I know the proper fix would be to add a cookie but this should take care of the problem in the meantime
