[Unit]
Description=ComfyUI (diffusion workflows on GB10, local NVMe install)
Documentation=https://github.com/comfyanonymous/ComfyUI
After=network-online.target comfyui-card.service
Wants=comfyui-card.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/local/comfyui/ComfyUI
# GB10 memory is unified: there is no separate VRAM to budget, so ComfyUI's
# default smart-memory behaviour is kept. "Free memory" on the card calls
# /free to hand resident model memory back to the llama-swap load gate.
Environment=PYTHONUNBUFFERED=1
Environment=HF_HUB_DISABLE_XET=1
ExecStart=/opt/local/comfyui/.venv/bin/python main.py \
    --listen 0.0.0.0 --port 8188 \
    --preview-method auto \
    --disable-auto-launch
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/opt/local/comfyui %h/.cache %h/.nv

[Install]
WantedBy=default.target
